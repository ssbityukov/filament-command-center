{
    "name": "ssbityukov/filament-command-center",
    "description": "Run pre-approved Artisan and shell commands from your Filament panel.",
    "keywords": [
        "laravel",
        "filament",
        "artisan",
        "commands"
    ],
    "homepage": "https://github.com/ssbityukov/filament-command-center",
    "license": "MIT",
    "authors": [
        {
            "name": "Sergey Bityukov",
            "email": "s.s.bityukov@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/ssbityukov/filament-command-center/issues",
        "source": "https://github.com/ssbityukov/filament-command-center"
    },
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.92",
        "symfony/process": "^7.0|^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-livewire": "^4.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Bityukov\\CommandCenter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bityukov\\CommandCenter\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bityukov\\CommandCenter\\CommandCenterServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
